{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    }
  ],
  "separate-pull-requests": true,
  "sequential-calls": true,
  "packages": {
    "charts/crunchy-userinit": {
      "release-type": "helm",
      "package-name": "chart",
      "include-v-in-tag": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "chore",
          "section": "Chores"
        }
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "charts/_README.gotmpl"
        },
        {
          "type": "generic",
          "path": "charts/crunchy-userinit/README.md"
        }
      ]
    },
    ".": {
      "release-type": "python",
      "exclude-paths": ["charts/", ".github/"],
      "extra-files": [
        {
          "type": "yaml",
          "path": "charts/crunchy-userinit/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value == 'crunchy-userinit-controller')].version"
        }
      ]
    }
  }
}
